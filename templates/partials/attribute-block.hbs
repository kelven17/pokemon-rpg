<div class="attribute-block" data-attribute="{{key}}">
    <label class="attr-label" data-action="rollAttribute" data-attribute="{{key}}" title="{{label}}">
        {{abbr}}
    </label>
    <input type="number" name="system.attributes.{{key}}.value" value="{{value}}" data-dtype="Number"/>
    <div class="attr-mod">{{signed mod}}</div>
</div>
