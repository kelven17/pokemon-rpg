<header class="sheet-header trainer-header">
    <svg class="trainer-emblem" viewBox="0 0 110 120" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Triangle marker (pink) -->
        <path d="M 58 52 L 100 110 L 50 80 Z"
              fill="#F8B4B4" stroke="#0A0A0A" stroke-width="4"
              stroke-linejoin="round" stroke-linecap="round"/>
        <circle cx="80" cy="86" r="4.5" fill="#EE1515" stroke="#0A0A0A" stroke-width="2.5"/>

        <!-- Pokéball: white base -->
        <circle cx="40" cy="40" r="36" fill="#FFFFFF" stroke="#0A0A0A" stroke-width="4"/>
        <!-- Red top half -->
        <path d="M 4 40 A 36 36 0 0 1 76 40 Z" fill="#EE1515" stroke="#0A0A0A" stroke-width="4" stroke-linejoin="round"/>
        <!-- Center band -->
        <line x1="4" y1="40" x2="76" y2="40" stroke="#0A0A0A" stroke-width="4"/>
        <!-- Center button -->
        <circle cx="40" cy="40" r="9" fill="#FFFFFF" stroke="#0A0A0A" stroke-width="4"/>
        <circle cx="40" cy="40" r="3" fill="#FFFFFF" stroke="#0A0A0A" stroke-width="2"/>
    </svg>
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
    <div class="header-fields">
        <h1 class="charname">
            <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'POKEMON_RPG.TrainerName'}}"/>
        </h1>
        <div class="header-row">
            <div class="resource">
                <label>{{localize "POKEMON_RPG.Level"}}</label>
                <input type="number" name="system.details.level" value="{{system.details.level}}" data-dtype="Number" min="1" max="{{config.maxTrainerLevel}}"/>
            </div>
            <div class="resource">
                <label>{{localize "POKEMON_RPG.Proficiency"}}</label>
                <span class="readonly">{{signed system.proficiency}}</span>
            </div>
            <div class="resource hp-block">
                <label>{{localize "POKEMON_RPG.Attribute.HP"}}</label>
                <div class="hp-row">
                    <input type="number" name="system.hp.value" value="{{system.hp.value}}" data-dtype="Number"/>
                    <span class="separator">/</span>
                    <input type="number" name="system.hp.max" value="{{system.hp.max}}" data-dtype="Number"/>
                </div>
            </div>
            <div class="resource">
                <label>{{localize "POKEMON_RPG.XP"}}</label>
                <div class="hp-row">
                    <input type="number" name="system.details.xp.value" value="{{system.details.xp.value}}" data-dtype="Number"/>
                    <span class="separator">/</span>
                    <input type="number" name="system.details.xp.max" value="{{system.details.xp.max}}" data-dtype="Number"/>
                </div>
            </div>
            <div class="resource talent-points-block" title="{{localize 'POKEMON_RPG.TalentPoints.Hint'}}">
                <label>{{localize "POKEMON_RPG.TalentPoints.Label"}}</label>
                <div class="hp-row">
                    <span class="readonly tp-available">{{system.talentPoints.available}}</span>
                    <span class="separator">/</span>
                    <span class="readonly tp-max">{{system.talentPoints.max}}</span>
                </div>
            </div>
        </div>
    </div>
</header>
