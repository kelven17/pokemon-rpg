<section class="tab {{#if (eq activeTab 'abilities')}}active{{/if}}" data-tab="abilities" data-group="primary">
    <div class="item-section">
        <header class="item-section-header">
            <h3>{{localize "POKEMON_RPG.Abilities"}}</h3>
            <button type="button" data-action="itemCreate" data-type="ability" class="create-btn">
                + {{localize "POKEMON_RPG.NewAbility"}}
            </button>
        </header>
        <ul class="items-list abilities-list">
            {{#each abilities}}
            <li class="item ability-item" data-item-id="{{this.id}}">
                <img src="{{this.img}}" class="item-img"/>
                <div class="ability-body">
                    <div class="ability-header">
                        <strong class="item-name">{{this.name}}</strong>
                        <span class="trigger-badge">{{localize (lookup @root.config.abilityTriggers this.system.triggerKey)}}</span>
                        {{#if this.system.hidden}}<span class="badge hidden-badge">{{localize "POKEMON_RPG.HiddenAbility"}}</span>{{/if}}
                    </div>
                    {{#if this.system.condicao}}
                    <div class="ability-condicao">
                        <span class="ability-label">{{localize "POKEMON_RPG.Ability.Condicao"}}:</span>
                        <em>{{this.system.condicao}}</em>
                    </div>
                    {{/if}}
                    {{#if this.effectHtml}}
                    <div class="ability-effect">
                        <span class="ability-label">{{localize "POKEMON_RPG.Ability.Effect"}}:</span>
                        <div class="ability-effect-body">{{{this.effectHtml}}}</div>
                    </div>
                    {{/if}}
                </div>
                <div class="item-controls">
                    <a data-action="itemEdit" title="{{localize 'POKEMON_RPG.Edit'}}"><i class="fas fa-edit"></i></a>
                    <a data-action="itemDelete" title="{{localize 'POKEMON_RPG.Delete'}}"><i class="fas fa-trash"></i></a>
                </div>
            </li>
            {{else}}
            <li class="empty">{{localize "POKEMON_RPG.NoAbilities"}}</li>
            {{/each}}
        </ul>
    </div>

    <div class="item-section">
        <header class="item-section-header">
            <h3>{{localize "POKEMON_RPG.Capacities"}}</h3>
            <button type="button" data-action="itemCreate" data-type="capacity" class="create-btn">
                + {{localize "POKEMON_RPG.NewCapacity"}}
            </button>
        </header>
        <ul class="items-list abilities-list">
            {{#each capacities}}
            <li class="item ability-item" data-item-id="{{this.id}}">
                <img src="{{this.img}}" class="item-img"/>
                <div class="ability-body">
                    <div class="ability-header">
                        <strong class="item-name">{{this.name}}</strong>
                        <span class="trigger-badge cap-cat-{{this.system.category}}">
                            {{localize (lookup @root.config.capacityCategories this.system.category)}}
                        </span>
                        {{#if this.system.value}}<span class="cap-value">{{this.system.value}}{{#if this.system.maxValue}}/{{this.system.maxValue}}{{/if}}</span>{{/if}}
                    </div>
                    {{#if this.descriptionHtml}}
                    <div class="ability-effect">
                        <div class="ability-effect-body">{{{this.descriptionHtml}}}</div>
                    </div>
                    {{/if}}
                </div>
                <div class="item-controls">
                    <a data-action="itemEdit" title="{{localize 'POKEMON_RPG.Edit'}}"><i class="fas fa-edit"></i></a>
                    <a data-action="itemDelete" title="{{localize 'POKEMON_RPG.Delete'}}"><i class="fas fa-trash"></i></a>
                </div>
            </li>
            {{else}}
            <li class="empty">{{localize "POKEMON_RPG.NoCapacities"}}</li>
            {{/each}}
        </ul>
    </div>
</section>
